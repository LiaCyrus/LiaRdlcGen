            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Constant">#[$].Replace([&amp;h_ngay_kh12],
	If([!d1.ngay_kh1] Is Nothing, "                ", CDate([!d1.ngay_kh1]).ToString("dd/MM/yyyy")),
    If([!d1.ngay_kh2] Is Nothing, "                ", CDate([!d1.ngay_kh2]).ToString("dd/MM/yyyy")))</Value>
                    <Style>
